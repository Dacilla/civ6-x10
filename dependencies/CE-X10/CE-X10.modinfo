<?xml version="1.0" encoding="utf-8"?>
<Mod id="397f2070-dfde-4124-88ce-e34249fc8190" version="1">
  <Properties>
    <Name>X10 CE Engine</Name>
    <Teaser>Required engine dependency for X10. No settings here; configure X10 from the main mod.</Teaser>
    <Description>Required engine for X10 — Configurable Bonus Multiplier. Enable this alongside the main X10 mod. It has no settings of its own.</Description>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>
  <FrontEndActions>
    <UpdateDatabase id="X10EngineRedirect">
      <File>Config/EngineRedirect.sql</File>
    </UpdateDatabase>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="X10EngineDummy">
      <File>Config/Dummy.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>Binaries/Win64/GameCore_XP2_CE_FinalRelease.dll</File>
    <File>Config/EngineRedirect.sql</File>
    <File>Config/Dummy.sql</File>
    <File>README.txt</File>
    <File>LICENSE.txt</File>
    <File>THIRD_PARTY_NOTICES.txt</File>
    <File>SOURCE.txt</File>
  </Files>
</Mod>
