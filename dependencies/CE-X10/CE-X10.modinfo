<?xml version="1.0" encoding="utf-8"?>
<Mod id="397f2070-dfde-4124-88ce-e34249fc8190" version="1">
  <Properties>
    <Name>X10 CE Engine</Name>
    <Description>GameCore replacement carrying the X10 native transformation engine (definition-population overrides). Required by the X10 controller mod. Built from CivilizationVI_CommunityExtension-X10, branch x10-lifecycle-log.</Description>
    <AffectsSavedGames>1</AffectsSavedGames>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>
  <FrontEndActions>
    <UpdateDatabase id="X10EngineRedirect">
      <File>Config/EngineRedirect.sql</File>
    </UpdateDatabase>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="X10EngineDummy">
      <File>Config/Dummy.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>Binaries/Win64/GameCore_XP2_CE_FinalRelease.dll</File>
    <File>Config/EngineRedirect.sql</File>
    <File>Config/Dummy.sql</File>
  </Files>
</Mod>
