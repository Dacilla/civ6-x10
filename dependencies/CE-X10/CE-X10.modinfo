<?xml version="1.0" encoding="utf-8"?>
<Mod id="397f2070-dfde-4124-88ce-e34249fc8190" version="1">
  <Properties>
    <Name>Overpowered Bonuses CE Engine</Name>
    <Teaser>Required engine for Overpowered Bonuses. It has no settings of its own.</Teaser>
    <Description>Required engine for Overpowered Bonuses. Configure all settings in the main mod. Do not enable another mod that replaces the game's GameCore at the same time.</Description>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
  </Dependencies>
  <FrontEndActions>
    <UpdateDatabase id="X10EngineRedirect">
      <File>Config/EngineRedirect.sql</File>
    </UpdateDatabase>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="X10EngineDummy">
      <File>Config/Dummy.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>Binaries/Win64/GameCore_XP2_CE_FinalRelease.dll</File>
    <File>Config/EngineRedirect.sql</File>
    <File>Config/Dummy.sql</File>
    <File>README.txt</File>
    <File>LICENSE.txt</File>
    <File>THIRD_PARTY_NOTICES.txt</File>
    <File>SOURCE.txt</File>
  </Files>
</Mod>
