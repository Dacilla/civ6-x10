<?xml version="1.0" encoding="utf-8"?>
<Mod id="55d7b934-62f9-46fb-a771-badf3d1a1538" version="1">
  <Properties>
    <Name>X10 (configurable semantic multiplier)</Name>
    <Description>Configurable Civ VI semantic multiplier with per-module controls. Requires the matching X10 CE Engine dependency.</Description>
