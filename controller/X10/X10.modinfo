<?xml version="1.0" encoding="utf-8"?>
<Mod id="55d7b934-62f9-46fb-a771-badf3d1a1538" version="1">
  <Properties>
    <Name>Overpowered Bonuses</Name>
    <Teaser>Multiply Civilization VI bonuses from ×2 to ×100 and choose which categories are affected.</Teaser>
    <Description>Choose a multiplier and the bonus categories it affects in Advanced Setup. ×10 is the default. Requires Overpowered Bonuses CE Engine.</Description>
    <AffectsSavedGames>1</AffectsSavedGames>
    <CompatibleVersions>2.0</CompatibleVersions>
    <SupportsSinglePlayer>1</SupportsSinglePlayer>
    <SupportsMultiplayer>0</SupportsMultiplayer>
  </Properties>
  <Dependencies>
    <Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
    <Mod id="397f2070-dfde-4124-88ce-e34249fc8190" title="Overpowered Bonuses CE Engine" />
  </Dependencies>
  <FrontEndActions>
    <UpdateDatabase id="X10Config">
      <File>Config/X10Config.sql</File>
    </UpdateDatabase>
    <UpdateText id="X10Text">
      <File>Config/X10Text.sql</File>
    </UpdateText>
  </FrontEndActions>
  <InGameActions>
    <UpdateDatabase id="X10Dummy">
      <File>Config/Dummy.sql</File>
    </UpdateDatabase>
    <UpdateDatabase id="X10WonderBridge">
      <File>Config/X10WonderBridge.sql</File>
    </UpdateDatabase>
  </InGameActions>
  <Files>
    <File>Config/X10Config.sql</File>
    <File>Config/X10Text.sql</File>
    <File>Config/Dummy.sql</File>
    <File>Config/X10WonderBridge.sql</File>
    <File>README.txt</File>
    <File>LICENSE.txt</File>
    <File>THIRD_PARTY_NOTICES.txt</File>
    <File>SOURCE.txt</File>
  </Files>
</Mod>
<!-- Mod id 55d7b934-... is the stable internal Civ VI mod ID for the X10
     controller. Depends on the X10 CE Engine (397f2070-...) for the
     GameCore replacement carrying the native transformation engine. -->
